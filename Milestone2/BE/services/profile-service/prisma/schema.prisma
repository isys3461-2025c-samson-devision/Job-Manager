generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

type ProfileAddress {
  city    String
  country String
  street  String
}

type ProfileBank {
  bankName        String
  bankNumber      String
  transactionTime String
}

type ProfileSkills {
  description String
  name        String
}

type ProfileWorkExperiences {
  description String
  endDate     String
  startDate   String
  title       String
}

model profile {
  id              String                   @id @default(auto()) @map("_id") @db.ObjectId
  GPA             Float
  address         ProfileAddress
  authId          String
  bank            ProfileBank
  birthday        String
  createdAt       DateTime                 @db.Date
  degree          String
  email           String
  institution     String
  isPremium       String
  mediaId         String
  name            String
  phone           String
  salaryRange     Int
  skills          ProfileSkills[]
  updatedAt       DateTime                 @db.Date
  workExperiences ProfileWorkExperiences[]
}
