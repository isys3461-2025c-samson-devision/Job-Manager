generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

type ProfileEducation {
  GPA         Float
  degree      String
  from        String
  institution String
  to          String
}

type ProfileWorkExperiences {
  description String
  endDate     String
  startDate   String
  title       String
}

model profile {
  id              String                   @id @default(auto()) @map("_id") @db.ObjectId
  authId          String
  birthday        String
  city            String
  country         String
  createdAt       DateTime                 @db.Date
  education       ProfileEducation[]
  email           String
  isPremium       String
  mediaId         String
  name            String
  phone           String
  salaryRange     Int
  skills          String[]
  street          String
  summary         String
  updatedAt       DateTime                 @db.Date
  workExperiences ProfileWorkExperiences[]
}
